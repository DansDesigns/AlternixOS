#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# alternix-net — non-interactive network verbs for osm-install
#
# Wraps the existing primitives in installer/network.sh so the GUI
# never has to reimplement them. network.sh itself is NOT modified.
#
# CONVENTION:
#   stdout  machine-readable data only (one record per line)
#   stderr  human-readable progress / errors
#   exit    0 = success, non-zero = failure
#
# VERBS
#   drivers                     load NIC + WiFi kernel modules
#   list                        iface<TAB>wifi|eth<TAB>up|down
#   scan <iface>                one SSID per line
#   connect-eth <iface>         bring up + DHCP
#   connect-wifi <iface> <ssid> associate + DHCP; PSK read from STDIN
#                               (blank stdin = open network)
#   status                      exit 0 if the internet is reachable
#   synctime                    set clock from HTTP Date header
#
# The PSK is read from stdin, never argv — argv is world-readable
# through /proc/<pid>/cmdline for the lifetime of the process.
# ═══════════════════════════════════════════════════════════════

set -uo pipefail

INSTALLER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Source the real modules ───────────────────────────────────────
# ui.sh must come first: network.sh calls info/ok/warn/err/spin_*.
# shellcheck source=/dev/null
source "${INSTALLER_DIR}/ui.sh"
# shellcheck source=/dev/null
source "${INSTALLER_DIR}/network.sh"

# ── Neutralise the TUI helpers ────────────────────────────────────
# network.sh's primitives call these. In a GUI context the spinner
# would fork a background loop writing escape codes forever, and the
# colour codes would corrupt the machine-readable stdout stream.
# Redefining them here changes nothing in ui.sh itself.
spin_start() { :; }
spin_stop()  { :; }
info()  { echo "$*"  >&2; }
ok()    { echo "$*"  >&2; }
warn()  { echo "$*"  >&2; }
err()   { echo "$*"  >&2; }
die()   { echo "$*"  >&2; exit 1; }
section() { :; }
banner()  { :; }

usage() {
    sed -n '2,25p' "${BASH_SOURCE[0]}" >&2
    exit 2
}

# ── Verbs ─────────────────────────────────────────────────────────
v_list() {
    local iface state
    while IFS= read -r iface; do
        [[ -z "$iface" ]] && continue
        state="down"
        [[ "$(cat "/sys/class/net/${iface}/operstate" 2>/dev/null)" == "up" ]] && state="up"
        if net_is_wireless "$iface"; then
            printf '%s\twifi\t%s\n' "$iface" "$state"
        else
            printf '%s\teth\t%s\n' "$iface" "$state"
        fi
    done < <(net_list_interfaces)
}

# The live-preview session already runs NetworkManager. Do not start a
# second wpa_supplicant or DHCP client against an NM-managed Wi-Fi device.
nm_running() {
    command -v nmcli >/dev/null 2>&1 &&
        [[ "$(nmcli -g RUNNING general 2>/dev/null)" == running ]]
}

v_scan() {
    local iface="${1:-}"
    [[ -n "$iface" ]] || die "scan: missing interface"
    net_is_wireless "$iface" || die "scan: ${iface} is not a wireless interface"
    if nm_running; then
        nmcli radio wifi on >/dev/null 2>&1 || true
        nmcli --wait 15 device wifi rescan ifname "$iface" >/dev/null 2>&1 || true
        nmcli -t --escape no -f SSID device wifi list ifname "$iface" | sed '/^$/d' | sort -u
    else
        net_wifi_scan "$iface"
    fi
}

v_connect_eth() {
    local iface="${1:-}"
    [[ -n "$iface" ]] || die "connect-eth: missing interface"
    if nm_running; then
        nmcli --wait 35 device connect "$iface" >&2
    else
        net_setup_ethernet "$iface"
    fi
}

# NetworkManager connection profiles are the source of truth in the live
# image and are copied into the installed system. Avoid nmcli's "password"
# argv option: command-line arguments expose secrets through /proc.
v_connect_wifi_nm() {
    local iface="$1" ssid="$2" psk="$3"
    local uuid conf hashed="" wpa_output="" security="" security_row="" use_sae=0
    uuid=$(cat /proc/sys/kernel/random/uuid) || die "Cannot obtain Wi-Fi profile UUID."
    mkdir -p /etc/NetworkManager/system-connections || return 1
    conf="/etc/NetworkManager/system-connections/alternix-installer-${uuid}.nmconnection"

    # Compute a WPA2 PSK from STDIN, never from command-line arguments.
    # This also avoids leaving the clear-text '#psk=' wpa_passphrase comment
    # in the installed connection file. For an open AP, omit security keys.
    if [[ -n "$psk" ]]; then
        # WPA3-SAE-only access points need the original passphrase, not the
        # WPA2 64-hex derived key. Transition-mode WPA2/WPA3 uses WPA2.
        while IFS= read -r security_row; do
            if [[ "$security_row" == "$ssid:"* ]]; then
                security="${security_row#"$ssid:"}"
                break
            fi
        done < <(nmcli -t --escape no -f SSID,SECURITY device wifi list ifname "$iface" 2>/dev/null)
        if [[ "$security" == *WPA3* && "$security" != *WPA2* ]]; then
            use_sae=1
        fi
        if (( use_sae )); then
            [[ ${#psk} -le 63 ]] || { echo "WPA3 password is too long." >&2; return 1; }
        else
            [[ ${#psk} -ge 8 && ${#psk} -le 63 ]] || {
                echo "WPA2 password must be 8–63 characters; the supplied length is ${#psk}." >&2
                return 1
            }
            command -v wpa_passphrase >/dev/null 2>&1 || die "wpa_passphrase is missing."
            if ! wpa_output=$(printf '%s\n' "$psk" | wpa_passphrase "$ssid" 2>&1); then
                echo "Could not prepare WPA credentials: ${wpa_output}" >&2
                return 1
            fi
            hashed=$(printf '%s\n' "$wpa_output" | sed -nE 's/^[[:space:]]*psk=([0-9a-fA-F]{64})[[:space:]]*$/\1/p' | head -n1)
            [[ ${#hashed} -eq 64 ]] || die "Could not generate a 64-digit WPA PSK."
        fi
    fi

    # A private NetworkManager keyfile is loaded explicitly. Unlike the
    # legacy code it does not kill NetworkManager's supplicant instance.
    umask 077
    {
        printf '[connection]\nid=Alternix-WiFi-%s\nuuid=%s\ntype=wifi\nautoconnect=true\n\n' "$uuid" "$uuid"
        printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$ssid"
        if (( use_sae )); then
            # SAE requires the original password. Keep file root-only (0600).
            printf '[wifi-security]\nkey-mgmt=sae\npsk=%s\n\n' "$psk"
        elif [[ -n "$hashed" ]]; then
            printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n' "$hashed"
        fi
        printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
    } > "$conf" || return 1
    chmod 600 "$conf"

    if ! nmcli connection load "$conf" >&2; then
        rm -f -- "$conf"
        echo "NetworkManager could not load the Wi-Fi connection profile." >&2
        return 1
    fi
    if ! nmcli --wait 45 connection up uuid "$uuid" ifname "$iface" >&2; then
        # Never leave a failed attempt's credentials in the live image.
        nmcli connection delete uuid "$uuid" >/dev/null 2>&1 || true
        rm -f -- "$conf"
        echo "NetworkManager failed to activate the connection (not necessarily a wrong password)." >&2
        return 1
    fi
    # Keep the NM profile: the prebuilt rootfs copy carries this secure
    # file into the installed system for automatic reconnection at boot.
    iw dev "$iface" set power_save off 2>/dev/null || true
    echo "Connected to '${ssid}' with NetworkManager." >&2
    return 0
}

# Non-NM fallback for the minimal net-install image. Unlike the live-preview
# path it runs directly through wpa_supplicant and dhcpcd, as before.
v_connect_wifi_legacy() {
    local iface="$1" ssid="$2" psk="$3" wpa_conf
    command -v wpa_supplicant >/dev/null 2>&1 || die "wpa_supplicant is missing."
    wpa_conf=$(mktemp /tmp/wpa.XXXXXX.conf) || return 1
    chmod 600 "$wpa_conf"
    if [[ -z "$psk" ]]; then
        printf 'network={\n  ssid="%s"\n  key_mgmt=NONE\n}\n' "$ssid" > "$wpa_conf"
    elif ! printf '%s\n' "$psk" | wpa_passphrase "$ssid" > "$wpa_conf"; then
        rm -f "$wpa_conf"
        echo "Could not prepare WPA credentials." >&2
        return 1
    fi
    pkill -f "wpa_supplicant.*${iface}" 2>/dev/null || true
    ip link set "$iface" up 2>/dev/null || true
    if ! wpa_supplicant -B -i "$iface" -c "$wpa_conf" >&2; then
        rm -f "$wpa_conf"
        echo "wpa_supplicant failed to start." >&2
        return 1
    fi
    if command -v wpa_cli >/dev/null 2>&1; then
        local attempt state=""
        for attempt in $(seq 1 25); do
            state=$(wpa_cli -i "$iface" status 2>/dev/null | sed -n 's/^wpa_state=//p')
            [[ "$state" == COMPLETED ]] && break
            sleep 1
        done
        if [[ "$state" != COMPLETED ]]; then
            rm -f "$wpa_conf"
            echo "Wi-Fi association failed (state: ${state:-unknown})." >&2
            return 1
        fi
    else
        sleep 4
    fi
    if ! net_dhcp "$iface"; then
        rm -f "$wpa_conf"
        echo "Associated to Wi-Fi but could not get a DHCP address." >&2
        return 1
    fi
    iw dev "$iface" set power_save off 2>/dev/null || true
    mkdir -p /etc/wpa_supplicant
    { printf 'ctrl_interface=/run/wpa_supplicant\nupdate_config=1\n'; cat "$wpa_conf"; } \
        > /etc/wpa_supplicant/wpa_supplicant.conf
    chmod 600 /etc/wpa_supplicant/wpa_supplicant.conf
    rm -f "$wpa_conf"
    echo "Connected to '${ssid}' with wpa_supplicant." >&2
}

v_connect_wifi() {
    local iface="${1:-}" ssid="${2:-}" psk=""
    [[ -n "$iface" ]] || die "connect-wifi: missing interface"
    [[ -n "$ssid" ]] || die "connect-wifi: missing SSID"
    # The GUI sends one line of UTF-8 followed by a newline.
    IFS= read -r psk || true
    if nm_running; then
        v_connect_wifi_nm "$iface" "$ssid" "$psk"
    else
        v_connect_wifi_legacy "$iface" "$ssid" "$psk"
    fi
}

v_status() {
    # NetworkManager's connectivity probe works on networks where ICMP to
    # 8.8.8.8 is blocked. Require actual internet for online-only options.
    if nm_running; then
        local connectivity
        connectivity=$(nmcli --wait 8 networking connectivity check 2>/dev/null) || true
        [[ "$connectivity" == full ]] && return 0
    fi
    net_is_connected
}

# ── Dispatch ──────────────────────────────────────────────────────
[[ $# -ge 1 ]] || usage

case "$1" in
    drivers)      net_load_drivers ;;
    list)         v_list ;;
    scan)         shift; v_scan "$@" ;;
    connect-eth)  shift; v_connect_eth "$@" ;;
    connect-wifi) shift; v_connect_wifi "$@" ;;
    status)       v_status ;;
    synctime)     net_sync_clock ;;
    *)            usage ;;
esac
